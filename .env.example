# Copy to .env. Never commit .env or real credentials.
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# REQUIRED: random token; configure the same token in NapCat reverse WS.
ONEBOT_ACCESS_TOKEN=
# JSON arrays of QQ IDs. [] means no superusers / allow all groups respectively.
SUPERUSERS=[]
ALLOWED_GROUPS=[]
# Kept at its original path so existing bot-data volumes retain their settings.
DATABASE_PATH=data/ryxbot.db
# Trusted Python module names only; plugins have the bot process permissions.
EXTRA_PLUGINS=[]
# 示例插件才需要以下设置；加载 docs.plugins.example_plugin 后再按需启用：
# EXTRA_PLUGINS=["docs.plugins.example_plugin"]
# ALING_EXAMPLE_ENABLED=true
# ALING_EXAMPLE_COOLDOWN_SECONDS=3
# ALING_EXAMPLE_MAX_PER_HOUR=10

# Configure credentials before a superuser enables AI with /feature global ai on.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_TIMEOUT=30
AI_MAX_INPUT_CHARS=2000
AI_MAX_OUTPUT_CHARS=1500
AI_MAX_TOKENS=512
AI_COOLDOWN_SECONDS=3
AI_MAX_PER_HOUR=20
AI_MAX_CONCURRENCY=2
# AI tool calls require compatible provider support and maintainer opt-in.
AI_TOOLS_ENABLED=false
# Tool calls are separately opted in and bounded; memory is volatile and group opt-in.
AI_TOOL_TIMEOUT=10
AI_TOOL_TURN_TIMEOUT=45
AI_SESSION_TTL=600
AI_SESSION_MAX_TURNS=6
AI_SESSION_MAX_CHARS=12000
AI_SESSION_MAX_COUNT=1000
# Default persona: src/aling/prompts/default.txt. AI_SYSTEM_PROMPT still overrides it.
# AI sees only enabled read-only tools; no system commands or group moderation tools.

# Superusers control global feature switches with /feature global; groups remain off until opted in.
MEME_DIR=data/memes

# Scheduled text is explicitly configured by an admin and persisted until removed.
# Both this global switch and /proactive on in a group are required to send.
# The daily scheduler also observes timezone, quiet hours, per-hour limits, and no-retry behavior.
PROACTIVE_ENABLED=false
PROACTIVE_COOLDOWN_SECONDS=300
PROACTIVE_MAX_PER_HOUR=3
PROACTIVE_MAX_PER_DAY=1
PROACTIVE_TIMEZONE=Asia/Shanghai
PROACTIVE_QUIET_START=23:00
PROACTIVE_QUIET_END=08:00
WEB_TIMEOUT=10
WEB_MAX_BYTES=1000000

# Optional Docker Compose settings (not account credentials).
# Legacy Compose override retained for existing deployment scripts.
# RYXBOT_ENV_FILE=.env
# NAPCAT_IMAGE=mlikiowa/napcat-docker:latest
# NAPCAT_UID=1000
# NAPCAT_GID=1000
